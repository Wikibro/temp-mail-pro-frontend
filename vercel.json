{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.html|robots.txt|sitemap.xml|sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
{
  "key": "Content-Security-Policy",
  "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net vercel.live *.vercel.live quge5.com *.quge5.com 3nbf4.com *.3nbf4.com bngpt.com *.bngpt.com v977v.com *.v977v.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net vercel.live *.vercel.live quge5.com *.quge5.com 3nbf4.com *.3nbf4.com bngpt.com *.bngpt.com v977v.com *.v977v.com; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net ://cloudflare.com ://googleapis.com; font-src 'self' ://gstatic.com ://cloudflare.com cdn.jsdelivr.net data:; img-src 'self' data: https: quge5.com *.quge5.com 3nbf4.com *.3nbf4.com; connect-src 'self' https://mail.tm https://onrender.com https://jsdelivr.net wss://*.vercel.live https://quge5.com https://*.quge5.com https://3nbf4.com https://*.3nbf4.com https://bngpt.com https://*.bngpt.com https://v977v.com https://*.v977v.com; frame-src 'self' https://quge5.com https://*.quge5.com https://3nbf4.com https://*.3nbf4.com https://bngpt.com https://*.bngpt.com https://v977v.com https://*.v977v.com; object-src 'none'; base-uri 'self';"
}


      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tempmailpk.vercel.app" }],
      "destination": "https://tempmailpk.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.tempmailpk.com" }],
      "destination": "https://tempmailpk.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" }, 
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/privacy-stack", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/cache-worker.js", "destination": "/cache-worker.js" },
    { "source": "/((?!assets/|fonts/|images/|icons/|api/|sw\\.js|cache-worker\\.js|robots\\.txt|sitemap\\.xml).*)", "destination": "/api/not-found" }
  ]

}
